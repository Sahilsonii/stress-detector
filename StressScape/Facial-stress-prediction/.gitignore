# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv*/
*.egg-info/
dist/
build/

# Datasets
original dataset/
dataset/
balanced_train/
balanced_validation/
data/

# Model weights / heavy training artifacts -- kept out of git everywhere.
# Small evidence files (metrics/reports/figures) are explicitly
# un-ignored below so Data Availability claims stay verifiable.
*.h5
*.pkl
*.pth
results/**/checkpoints/
results/**/saved_model/

# Monitoring logs / personal captures -- never tracked.
logs/
stress_monitoring/

# Images (ignore by default; keep result evidence figures)
*.jpg
*.jpeg
*.gif
*.png
!results/**/confusion_matrix*.png
!results/**/*_history.png
!results/**/feature_importance.png
!results/**/threshold_optimization.png
!results/comparison/*.png

# Reports (ignore by default; keep the regenerated comparison PDF)
*.pdf
!results/FINAL_MODEL_COMPARISON_REPORT.pdf

# CSV -- raw datasets and personal session logs stay ignored
*.csv

# Evidence JSON/TXT under results/ -- kept for reproducibility
!results/**/metrics.json
!results/**/classification_report.txt
!results/**/feature_statistics.json
!results/**/split_summary.json
!results/**/threshold_table.json

# Jupyter
.ipynb_checkpoints/
*.ipynb

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Temporary
*.tmp
*.bak
*.log
